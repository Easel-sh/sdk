{
  "name": "@easel-sh/sdk",
  "version": "0.1.2",
  "description": "Deploy and manage apps on Easel from any JavaScript runtime.",
  "keywords": [
    "easel",
    "deploy",
    "hosting",
    "sdk"
  ],
  "homepage": "https://easel.sh/docs/sdk",
  "bugs": "https://github.com/Easel-sh/sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Easel-sh/sdk.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ignore": "^7.0.14"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  }
}
